{
  "title": "OpenPaw \u2014 Platform Overview",
  "description": "Single pane of glass for OpenPaw agent orchestration health, runtime behavior, and Temper platform metrics.",
  "layout_type": "ordered",
  "widgets": [
    {
      "definition": {
        "title": "Platform Health",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "OTLP Spans Received",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.otlp.spans{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OTLP Traces Received",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.otlp.traces{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Trace Agent Sampler (Kept vs Seen)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.sampler.kept{*}.as_count()",
                  "display_type": "line"
                },
                {
                  "q": "sum:datadog.trace_agent.sampler.seen{*}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Metrics Pipeline Canary",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_up{service:openpaw}",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "APM Traces (service:openpaw)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Spans by Resource",
              "type": "toplist",
              "requests": [
                {
                  "q": "top(count:trace.custom{service:openpaw} by {resource_name}.as_count(), 10, 'sum', 'desc')",
                  "conditional_formats": [],
                  "style": {}
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Trace Flame Graph",
              "type": "trace_service",
              "service": "openpaw",
              "env": "",
              "span_name": "",
              "show_hits": true,
              "show_errors": true,
              "show_latency": true,
              "show_breakdown": true,
              "size_format": "large",
              "display_format": "three_column"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Core Runtime",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Active Entities",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_active_entities{*}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Indexed Entities (Query Plane)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_indexed_entities{service:openpaw,tenant:*}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Projected Entities (Durable Catalog)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_projected_entities{service:openpaw,tenant:*}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Projection Coverage",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_projection_coverage_ratio{service:openpaw}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Active Actors (Hydrated)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_active_actors{service:openpaw}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OpenPaw Process Memory (RSS)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:process_resident_memory_bytes{service:openpaw}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Indexed Entities by Host",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_indexed_entities{service:openpaw,tenant:*} by {host}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Active Actors by Host",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_active_actors{service:openpaw} by {host}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OpenPaw RSS by Host",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:process_resident_memory_bytes{service:openpaw} by {host}",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Persistence & Recovery",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Projection Snapshot Misses",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_projection_backfill_snapshot_misses_total{service:openpaw}.as_count().rollup(sum, 60))",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Startup Live Restore Entities",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_startup_live_restore_entities_total{service:openpaw} by {tenant}.as_count().rollup(sum, 60))",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OS App Reconcile",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_os_app_reconcile_total{service:openpaw} by {app,result}.as_count().rollup(sum, 60))",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OS App Reconcile Duration",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(avg:temper_os_app_reconcile_duration_ms{service:openpaw} by {app,result}.rollup(avg, 60))",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Event Replay Duration",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_event_replay_duration{service:openpaw} by {tenant,entity_type}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Turso Query Duration",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_turso_query_duration{service:openpaw} by {operation}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Authz & WASM",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Cedar Evaluations",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_cedar_evaluations_total{service:openpaw}.as_count().rollup(sum, 60))",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Invocations",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_wasm_invocations_total{service:openpaw} by {trigger_action,success}.as_count().rollup(sum, 60))",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Invoke Duration (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_wasm_invocation_duration_ms{service:openpaw} by {trigger_action}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Host HTTP Requests",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_wasm_host_http_requests_total{service:openpaw} by {call_kind,status_code_class}.as_count().rollup(sum, 60))",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Host HTTP Duration (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_wasm_host_http_duration_ms{service:openpaw} by {call_kind,status_code_class}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Host HTTP Request Bytes",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_wasm_host_http_request_bytes{service:openpaw} by {call_kind,status_code_class}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Host HTTP Response Bytes",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_wasm_host_http_response_bytes{service:openpaw} by {call_kind,status_code_class}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Default-Timeout Fallbacks",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "fallbacks",
                      "query": "sum:temper_wasm_integration_default_timeout_used_total{service:openpaw} by {tenant,entity_type,module}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "fallbacks"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Blob & Monty",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Blob I/O Wait (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_blob_io_wait_duration_ms{service:openpaw} by {operation}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Local Blob Fast Path Requests",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_blob_local_fast_path_requests_total{service:openpaw} by {method}.as_count().rollup(sum, 60))",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Remote Blob Transport Wait (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_blob_transport_wait_duration_ms{service:openpaw} by {backend,http_method}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Remote Blob Transport Requests",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_blob_transport_requests_total{service:openpaw} by {backend,http_method}.as_count().rollup(sum, 60))",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Executions",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_wasm_invocations_total{service:openpaw,trigger_action:processtoolcalls,needs_wasi:true,success:true}.as_count().rollup(sum, 60))",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Observed Monty Overlap (max active)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "max:temper_monty_repl_observed_active_invocations{service:openpaw}.rollup(max, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Wait (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_monty_repl_wait_duration_ms{service:openpaw} by {max_concurrency}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Acquisitions by Configured Cap",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_monty_repl_acquisitions_total{service:openpaw} by {max_concurrency}.as_count().rollup(sum, 60))",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Session Context & Provider Pipeline",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Session Context Tokens",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_session_context_tokens{service:openpaw} by {provider}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Session Context Bytes",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_session_context_bytes{service:openpaw} by {provider}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Context Prepare Duration (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_session_context_prepare_duration_ms{service:openpaw}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Prepared Context Entries Loaded",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_session_context_entries_loaded{service:openpaw}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Prepared Context Content Files Loaded",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_session_context_content_files_loaded{service:openpaw}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Provider Request Bytes",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_session_provider_request_bytes{service:openpaw} by {provider}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Provider Response Bytes",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_session_provider_response_bytes{service:openpaw} by {provider}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Session Memory Budget Exceeded",
              "type": "timeseries",
              "requests": [
                {
                  "q": "default_zero(sum:temper_session_memory_limit_exceeded_total{service:openpaw}.as_count().rollup(sum, 60))",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Session Large Content Externalized",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "externalized",
                      "query": "sum:temper_session_large_content_externalized_total{service:openpaw} by {entity_type}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "externalized"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Dispatch Resilience (ADR-0048)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Ask Outcome Mix",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_dispatch_ask_outcome_total{service:openpaw} by {outcome}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Ask Attempts Distribution",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p50:temper_dispatch_ask_attempts{service:openpaw}",
                  "display_type": "line"
                },
                {
                  "q": "p95:temper_dispatch_ask_attempts{service:openpaw}",
                  "display_type": "line"
                },
                {
                  "q": "p99:temper_dispatch_ask_attempts{service:openpaw}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Top Actions Saved by Retry Layer",
              "type": "toplist",
              "requests": [
                {
                  "q": "top(sum:temper_dispatch_ask_outcome_total{service:openpaw,outcome:transient_retried_ok} by {entity_type,action}.as_count(), 10, 'sum', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Dispatch Tail Latency by Entity",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p99:temper_dispatch_ask_latency_ms{service:openpaw} by {entity_type}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "ActorError Kind Breakdown",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_dispatch_ask_error_total{service:openpaw} by {error_kind}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Dispatch Attempts Percentiles",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p50",
                      "query": "p50:temper_dispatch_ask_attempts{service:openpaw}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "p95",
                      "query": "p95:temper_dispatch_ask_attempts{service:openpaw}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "p99",
                      "query": "p99:temper_dispatch_ask_attempts{service:openpaw}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "p50",
                      "alias": "p50"
                    },
                    {
                      "formula": "p95",
                      "alias": "p95"
                    },
                    {
                      "formula": "p99",
                      "alias": "p99"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "State Liveness (ADR-0049 / ADR-0050)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Timeouts Fired by State",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_state_timeout_fired_total{service:openpaw} by {entity_type,state}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Time-in-State p95",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p95:temper_state_time_in_state_seconds{service:openpaw} by {entity_type,state}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Timer Reset Ratio",
              "type": "query_value",
              "requests": [
                {
                  "q": "sum:temper_state_timeout_reset_total{service:openpaw}.as_count() / (sum:temper_state_timeout_reset_total{service:openpaw}.as_count() + sum:temper_state_timeout_fired_total{service:openpaw}.as_count())"
                }
              ],
              "precision": 3
            }
          },
          {
            "definition": {
              "title": "Pending Timers per Entity Type",
              "type": "toplist",
              "requests": [
                {
                  "q": "avg:temper_scheduler_pending_timers{service:openpaw} by {entity_type}"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Overdue Timers on Replay",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_scheduler_overdue_on_replay_total{service:openpaw} by {entity_type}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Liveness Violations at Boot",
              "type": "toplist",
              "requests": [
                {
                  "q": "sum:temper_spec_liveness_violations_total{service:openpaw} by {entity_type,state}.as_count()"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Admission Control (ADR-0051)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Active Permits",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_admission_active_permits{service:openpaw} by {entity_type,action}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Queue Depth by Tenant",
              "type": "heatmap",
              "requests": [
                {
                  "q": "avg:temper_admission_queue_depth{service:openpaw} by {tenant,entity_type}"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Grant / Queue / Defer Mix",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_admission_granted_total{service:openpaw}.as_count()",
                  "display_type": "bars"
