{
  "title": "OpenPaw — Platform Overview",
  "description": "Single pane of glass for OpenPaw agent orchestration health.",
  "layout_type": "ordered",
  "widgets": [
    {
      "definition": {
        "title": "Platform Health",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "OTLP Spans Received",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.otlp.spans{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OTLP Traces Received",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.otlp.traces{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Trace Agent Sampler (Kept vs Seen)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.sampler.kept{*}.as_count()",
                  "display_type": "line"
                },
                {
                  "q": "sum:datadog.trace_agent.sampler.seen{*}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "APM Traces (service:openpaw)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Spans by Resource",
              "type": "toplist",
              "requests": [
                {
                  "q": "top(count:trace.custom{service:openpaw} by {resource_name}.as_count(), 10, 'sum', 'desc')",
                  "conditional_formats": [],
                  "style": {}
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Trace Flame Graph",
              "type": "trace_service",
              "service": "openpaw",
              "env": "",
              "span_name": "",
              "show_hits": true,
              "show_errors": true,
              "show_latency": true,
              "show_breakdown": true,
              "size_format": "large",
              "display_format": "three_column"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Runtime Metrics",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Indexed Entities (Query Plane)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_indexed_entities{service:openpaw,tenant:*}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Projected Entities (Durable Catalog)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_projected_entities{service:openpaw,tenant:*}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Projection Coverage",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_projection_coverage_ratio{service:openpaw}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Active Actors (Hydrated)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_active_actors{service:openpaw}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OpenPaw Process Memory (RSS)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:process_resident_memory_bytes{service:openpaw}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Indexed Entities by Host",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_indexed_entities{service:openpaw,tenant:*} by {host}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Active Actors by Host",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_active_actors{service:openpaw} by {host}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OpenPaw RSS by Host",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:process_resident_memory_bytes{service:openpaw} by {host}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Projection Snapshot Misses",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_projection_backfill_snapshot_misses_total{service:openpaw}.as_count().rollup(sum, 60)",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Startup Phase Duration",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_startup_phase_duration_ms{service:openpaw} by {phase}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Startup Time To Healthy",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_startup_time_to_healthy_ms{service:openpaw}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Startup Live Restore Entities",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_startup_live_restore_entities_total{service:openpaw} by {tenant}.as_count().rollup(sum, 60)",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OS App Reconcile",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_os_app_reconcile_total{service:openpaw} by {app,result}.as_count().rollup(sum, 60)",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OS App Reconcile Duration",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_os_app_reconcile_duration_ms{service:openpaw} by {app,result}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Load Failures",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_wasm_module_load_failures_total{service:openpaw} by {app,module,reason,criticality}.as_count().rollup(sum, 60)",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Modules Skipped",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_wasm_module_skipped_total{service:openpaw} by {app,module,reason,criticality}.as_count().rollup(sum, 60)",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Invocations",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_wasm_invocations_total{*} by {trigger_action,success}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Invoke Duration (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_wasm_invocation_duration_ms{*} by {trigger_action}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Host HTTP Response Bytes",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_wasm_host_http_response_bytes{*} by {call_kind,status_code_class}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Blob I/O Wait (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_blob_io_wait_duration_ms{*} by {operation}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Local Blob Fast Path Requests",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_blob_local_fast_path_requests_total{*} by {method}.as_count().rollup(sum, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Remote Blob Transport Wait (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_blob_transport_wait_duration_ms{*} by {backend,http_method}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Remote Blob Transport Requests",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_blob_transport_requests_total{*} by {backend,http_method}.as_count().rollup(sum, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Executions",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_wasm_invocations_total{trigger_action:processtoolcalls,needs_wasi:true,success:true}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Observed Monty Overlap (max active)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "max:temper_monty_repl_observed_active_invocations{*}.rollup(max, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Wait (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_monty_repl_wait_duration_ms{*} by {max_concurrency}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Acquisitions by Configured Cap",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_monty_repl_acquisitions_total{*} by {max_concurrency}.as_count().rollup(sum, 60)",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "tags": ["team:openpaw"]
}
