<?xml version="1.0" encoding="utf-8"?>
<!-- OData CSDL model for paw-consilium.
     Multi-perspective deliberation with context isolation. -->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="Consilium" xmlns="http://docs.oasis-open.org/odata/ns/edm">

      <!-- Deliberation: orchestrates multi-perspective examination -->
      <EntityType Name="Deliberation">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Created" />
        <Property Name="Intent" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="KnowledgeFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="ConfigJson" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="PerspectiveCount" Type="Edm.Int32" Nullable="false" DefaultValue="0" />
        <Property Name="PerspectivesComplete" Type="Edm.Int32" Nullable="false" DefaultValue="0" />
        <Property Name="BriefId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="ErrorMessage" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <!-- Perspective: context-isolated viewpoint -->
      <EntityType Name="Perspective">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Created" />
        <Property Name="DeliberationId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Role" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Model" Type="Edm.String" Nullable="false" DefaultValue="claude-sonnet-4-6" />
        <Property Name="Provider" Type="Edm.String" Nullable="false" DefaultValue="anthropic" />
        <Property Name="Temperature" Type="Edm.String" Nullable="false" DefaultValue="1.0" />
        <Property Name="Lens" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="SessionId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="OutputFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="ErrorMessage" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <!-- Brief: synthesized multi-perspective output -->
      <EntityType Name="Brief">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Draft" />
        <Property Name="DeliberationId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="ContentFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Summary" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="PerspectiveCount" Type="Edm.Int32" Nullable="false" DefaultValue="0" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <EntityContainer Name="ConsiliumContainer">
        <EntitySet Name="Deliberations" EntityType="Consilium.Deliberation" />
        <EntitySet Name="Perspectives" EntityType="Consilium.Perspective" />
        <EntitySet Name="Briefs" EntityType="Consilium.Brief" />
      </EntityContainer>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
