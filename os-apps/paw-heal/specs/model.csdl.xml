<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="Paw.Vocab" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Term Name="AuthZ.CedarPolicy" Type="Edm.String" AppliesTo="EntityType Action Function"/>
      <Term Name="Agent.Hint" Type="Edm.String" AppliesTo="Action Function EntityType"/>
    </Schema>

    <Schema Namespace="OpenPaw.Heal" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <EntityType Name="Monitor">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="DdQuery" Type="Edm.String"/>
        <Property Name="Threshold" Type="Edm.String"/>
        <Property Name="DdMonitorId" Type="Edm.String"/>
        <Property Name="LastAlertPayload" Type="Edm.String"/>
        <Property Name="AlertCount" Type="Edm.Int64"/>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Represents a live Datadog-backed watch for self-healing."/>
      </EntityType>

      <EntityType Name="AlertCycle">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="MonitorId" Type="Edm.String"/>
        <Property Name="AlertPayload" Type="Edm.String"/>
        <Property Name="Diagnosis" Type="Edm.String"/>
        <Property Name="PrUrl" Type="Edm.String"/>
        <Property Name="SreAgentId" Type="Edm.String"/>
        <Property Name="DeveloperAgentId" Type="Edm.String"/>
        <Property Name="TuningNotes" Type="Edm.String"/>
        <Property Name="MergeSha" Type="Edm.String"/>
        <Property Name="DeploymentUrl" Type="Edm.String"/>
        <Annotation Term="Paw.Vocab.AuthZ.CedarPolicy" String="policies/alert_cycle.cedar"/>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Tracks triage, remediation, CI/CD closure, and tuning for one alert."/>
      </EntityType>

      <Action Name="Configure" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.Monitor"/>
        <Parameter Name="dd_query" Type="Edm.String" Nullable="false"/>
        <Parameter Name="threshold" Type="Edm.String" Nullable="true"/>
        <Parameter Name="dd_monitor_id" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.Monitor"/>
      </Action>

      <Action Name="Activate" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.Monitor"/>
        <ReturnType Type="OpenPaw.Heal.Monitor"/>
      </Action>

      <Action Name="AlertFired" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.Monitor"/>
        <Parameter Name="last_alert_payload" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="OpenPaw.Heal.Monitor"/>
      </Action>

      <Action Name="Tune" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.Monitor"/>
        <Parameter Name="dd_query" Type="Edm.String" Nullable="true"/>
        <Parameter Name="threshold" Type="Edm.String" Nullable="true"/>
        <Parameter Name="dd_monitor_id" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.Monitor"/>
      </Action>

      <Action Name="Pause" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.Monitor"/>
        <ReturnType Type="OpenPaw.Heal.Monitor"/>
      </Action>

      <Action Name="Archive" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.Monitor"/>
        <ReturnType Type="OpenPaw.Heal.Monitor"/>
      </Action>

      <Action Name="Open" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="monitor_id" Type="Edm.String" Nullable="false"/>
        <Parameter Name="alert_payload" Type="Edm.String" Nullable="false"/>
        <Parameter Name="sre_agent_id" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <Action Name="HealComplete" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="diagnosis" Type="Edm.String" Nullable="true"/>
        <Parameter Name="pr_url" Type="Edm.String" Nullable="true"/>
        <Parameter Name="developer_agent_id" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <Action Name="TuneComplete" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="diagnosis" Type="Edm.String" Nullable="true"/>
        <Parameter Name="tuning_notes" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <Action Name="Escalate" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="diagnosis" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <Action Name="BeginMerge" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="pr_url" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <Action Name="MergeComplete" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="merge_sha" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <Action Name="DeployDetected" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="deployment_url" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <Action Name="AlertResolved" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="diagnosis" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <Action Name="AlertPersists" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.AlertCycle"/>
        <Parameter Name="diagnosis" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.AlertCycle"/>
      </Action>

      <EntityType Name="MonitorScan">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="ProjectHarnessId" Type="Edm.String"/>
        <Property Name="ScanType" Type="Edm.String"/>
        <Property Name="CommitSha" Type="Edm.String"/>
        <Property Name="MonitorsCreated" Type="Edm.Int64"/>
        <Property Name="MonitorsUpdated" Type="Edm.Int64"/>
        <Property Name="ErrorMessage" Type="Edm.String"/>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Tracks automated Datadog monitor generation for a project codebase."/>
      </EntityType>

      <Action Name="Configure" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.MonitorScan"/>
        <Parameter Name="project_harness_id" Type="Edm.String" Nullable="false"/>
        <Parameter Name="scan_type" Type="Edm.String" Nullable="true"/>
        <Parameter Name="commit_sha" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.MonitorScan"/>
      </Action>

      <Action Name="StartScan" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.MonitorScan"/>
        <ReturnType Type="OpenPaw.Heal.MonitorScan"/>
      </Action>

      <Action Name="ScanComplete" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.MonitorScan"/>
        <Parameter Name="monitors_created" Type="Edm.Int64" Nullable="true"/>
        <Parameter Name="monitors_updated" Type="Edm.Int64" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.MonitorScan"/>
      </Action>

      <Action Name="ScanFailed" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Heal.MonitorScan"/>
        <Parameter Name="error_message" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Heal.MonitorScan"/>
      </Action>

      <EntityContainer Name="Service">
        <EntitySet Name="Monitors" EntityType="OpenPaw.Heal.Monitor"/>
        <EntitySet Name="AlertCycles" EntityType="OpenPaw.Heal.AlertCycle"/>
        <EntitySet Name="MonitorScans" EntityType="OpenPaw.Heal.MonitorScan"/>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
