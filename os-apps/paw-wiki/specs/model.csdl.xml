<?xml version="1.0" encoding="utf-8"?>
<!-- OData CSDL model for paw-wiki entities.
     Three entity types: WikiSource, WikiPage, WikiJob.
     All content is domain-neutral; domain knowledge lives in
     freeform JSON fields decided by the consuming app at runtime. -->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="WikiCore" xmlns="http://docs.oasis-open.org/odata/ns/edm">

      <!-- WikiSource: raw material submitted for processing -->
      <EntityType Name="WikiSource">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Submitted" />
        <Property Name="ScopeId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Title" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="SourceType" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="SourceUrl" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="FileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Metadata" Type="Edm.String" Nullable="false" DefaultValue="{}" />
        <Property Name="ExtractedTopics" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="DerivedPageIds" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="ErrorMessage" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <!-- WikiPage: synthesized, versioned knowledge article -->
      <EntityType Name="WikiPage">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Drafting" />
        <Property Name="ScopeId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Slug" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Title" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Category" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="FileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Summary" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CrossReferences" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="SourceIds" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="Tags" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="Version" Type="Edm.Int32" Nullable="false" DefaultValue="0" />
        <Property Name="RevisionRationale" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="LintStatus" Type="Edm.String" Nullable="false" DefaultValue="{}" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <!-- WikiJob: task queue entry for wiki agent sessions -->
      <EntityType Name="WikiJob">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Queued" />
        <Property Name="JobType" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="ScopeId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="WorkspaceId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Input" Type="Edm.String" Nullable="false" DefaultValue="{}" />
        <Property Name="Output" Type="Edm.String" Nullable="false" DefaultValue="{}" />
        <Property Name="ProgressLog" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="ErrorMessage" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="SoulId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Model" Type="Edm.String" Nullable="false" DefaultValue="claude-sonnet-4-6" />
        <Property Name="Provider" Type="Edm.String" Nullable="false" DefaultValue="anthropic" />
        <Property Name="Temperature" Type="Edm.String" Nullable="false" DefaultValue="1.0" />
        <Property Name="ToolsEnabled" Type="Edm.String" Nullable="false" DefaultValue="temper_get,temper_list,temper_create,temper_action,temper_write,temper_read,temper_web_search,temper_web_fetch" />
        <Property Name="MaxTurns" Type="Edm.String" Nullable="false" DefaultValue="250" />
        <Property Name="UserMessage" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="SessionId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <EntityContainer Name="WikiContainer">
        <EntitySet Name="WikiSources" EntityType="WikiCore.WikiSource" />
        <EntitySet Name="WikiPages" EntityType="WikiCore.WikiPage" />
        <EntitySet Name="WikiJobs" EntityType="WikiCore.WikiJob" />
      </EntityContainer>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
