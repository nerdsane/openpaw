<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="OpenPaw.Research" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <EntityType Name="WebQuery">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="QueryType" Type="Edm.String"/>
        <Property Name="Query" Type="Edm.String"/>
        <Property Name="Url" Type="Edm.String"/>
        <Property Name="Results" Type="Edm.String"/>
        <Property Name="Error" Type="Edm.String"/>
        <Annotation Term="Paw.Vocab.AuthZ.CedarPolicy" String="policies/research.cedar"/>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Execute web search or URL fetch as a governed, auditable entity."/>
      </EntityType>

      <Action Name="ExecuteSearch" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Research.WebQuery"/>
        <Parameter Name="query" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="OpenPaw.Research.WebQuery"/>
      </Action>

      <Action Name="ExecuteFetch" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Research.WebQuery"/>
        <Parameter Name="url" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="OpenPaw.Research.WebQuery"/>
      </Action>

      <Action Name="RecordResults" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Research.WebQuery"/>
        <Parameter Name="results" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Research.WebQuery"/>
      </Action>

      <Action Name="RecordError" IsBound="true">
        <Parameter Name="bindingParameter" Type="OpenPaw.Research.WebQuery"/>
        <Parameter Name="error" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="OpenPaw.Research.WebQuery"/>
      </Action>

      <EntityContainer Name="ResearchService">
        <EntitySet Name="WebQueries" EntityType="OpenPaw.Research.WebQuery"/>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
