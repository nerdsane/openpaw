<?xml version="1.0" encoding="utf-8"?>
<!-- OData CSDL model for paw-autoreason.
     Tournament-based artifact refinement with convergence detection. -->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="Autoreason" xmlns="http://docs.oasis-open.org/odata/ns/edm">

      <!-- Tournament: orchestrates iterative refinement rounds -->
      <EntityType Name="Tournament">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Created" />
        <Property Name="ArtifactFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CurrentVersionAId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="RoundCount" Type="Edm.Int32" Nullable="false" DefaultValue="0" />
        <Property Name="MaxRounds" Type="Edm.Int32" Nullable="false" DefaultValue="10" />
        <Property Name="ConsecutiveIncumbentWins" Type="Edm.Int32" Nullable="false" DefaultValue="0" />
        <Property Name="ConvergenceK" Type="Edm.Int32" Nullable="false" DefaultValue="2" />
        <Property Name="JudgeCount" Type="Edm.Int32" Nullable="false" DefaultValue="5" />
        <Property Name="AuthorTemperature" Type="Edm.String" Nullable="false" DefaultValue="0.8" />
        <Property Name="JudgeTemperature" Type="Edm.String" Nullable="false" DefaultValue="0.3" />
        <Property Name="JudgeConfigJson" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="FinalVersionFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="DomainContext" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="ErrorMessage" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <!-- Round: one iteration of critique-revise-judge -->
      <EntityType Name="Round">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Active" />
        <Property Name="TournamentId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="RoundNumber" Type="Edm.Int32" Nullable="false" DefaultValue="0" />
        <Property Name="VersionAFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="VersionBFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="VersionABFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CritiqueFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Winner" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="BordaScoresJson" Type="Edm.String" Nullable="false" DefaultValue="{}" />
        <Property Name="LabelMappingJson" Type="Edm.String" Nullable="false" DefaultValue="{}" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <!-- Version: a specific artifact version within a round -->
      <EntityType Name="Version">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Created" />
        <Property Name="RoundId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="TournamentId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="Label" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="ContentFileId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <!-- Judgment: one judge's evaluation of a round's versions -->
      <EntityType Name="Judgment">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false" />
        <Property Name="State" Type="Edm.String" Nullable="false" DefaultValue="Created" />
        <Property Name="RoundId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="TournamentId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="JudgeSessionId" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="JudgeModel" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="JudgeProvider" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="RankingJson" Type="Edm.String" Nullable="false" DefaultValue="[]" />
        <Property Name="Reasoning" Type="Edm.String" Nullable="false" DefaultValue="" />
        <Property Name="RandomizedLabelsJson" Type="Edm.String" Nullable="false" DefaultValue="{}" />
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" />
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" />
      </EntityType>

      <EntityContainer Name="AutoreasonContainer">
        <EntitySet Name="Tournaments" EntityType="Autoreason.Tournament" />
        <EntitySet Name="Rounds" EntityType="Autoreason.Round" />
        <EntitySet Name="Versions" EntityType="Autoreason.Version" />
        <EntitySet Name="Judgments" EntityType="Autoreason.Judgment" />
      </EntityContainer>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
