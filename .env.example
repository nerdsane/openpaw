# OpenPaw example environment
# Copy to `.env` for local development. Values marked "deploy script" are set automatically
# by `openpaw deploy`. Values marked "dashboard" are usually managed from `/dashboard/settings`.

# Core runtime
PORT=3467
# Tenant name for this OpenPaw instance. "default" is fine for single-user deploys.
PAW_TENANT=default
PUBLIC_BASE_URL=http://localhost:3467

# Storage
# TURSO_URL=libsql://your-instance.turso.io               # deploy script
# TURSO_AUTH_TOKEN=...                                    # deploy script

# Blob storage
# BLOB_ENDPOINT=https://...                               # deploy script
# BLOB_BUCKET=openpaw-fs                                  # deploy script
# BLOB_ACCESS_KEY=...                                     # deploy script
# BLOB_SECRET_KEY=...                                     # deploy script

# Auto-generated on first boot if omitted
# TEMPER_API_KEY=
# TEMPER_VAULT_KEY=

# Dashboard-managed personal config
# LLM_PROVIDER=anthropic                                  # dashboard
# ANTHROPIC_API_KEY=                                      # dashboard
# OPENROUTER_API_KEY=                                     # dashboard
# OPENAI_API_KEY=                                         # dashboard
# OPENAI_CODEX_TOKEN=                                     # dashboard
# DISCORD_BOT_TOKEN=                                      # dashboard
# DISCORD_PUBLIC_KEY=                                     # dashboard
# DISCORD_GUILD_ID=                                       # dashboard
# DISCORD_FEED_CHANNEL_ID=                                # dashboard
# DISCORD_FORUM_CHANNEL_ID=                               # dashboard
# SLACK_APP_TOKEN=                                        # dashboard
# SLACK_BOT_TOKEN=                                        # dashboard
# SLACK_SIGNING_SECRET=                                   # dashboard
# GITHUB_TOKEN=                                           # dashboard
# EXA_API_KEY=                                            # dashboard

# Observability — OTEL collector is always deployed, Datadog activates when DD_API_KEY is set
# DD_API_KEY=                                              # set before deploy for Datadog, or add later in Railway
# DD_APP_KEY=                                              # optional, for Datadog dashboard/monitor APIs
# DD_SITE=datadoghq.com
DD_ENV=local                                              # "local" for dev, deploy script sets "prod" on Railway
# OTEL_ENABLED=true                                        # deploy script sets automatically
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317        # deploy script sets to Railway internal URL

# Optional sandbox + deployment providers
# TL_API_KEY=
# SANDBOX_PROVIDER=tensorlake
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...
# FLY_API_TOKEN=
# RAILWAY_TOKEN=
# VERCEL_TOKEN=

# Local tunnel support
NGROK_BIN=ngrok
# NGROK_AUTHTOKEN=
