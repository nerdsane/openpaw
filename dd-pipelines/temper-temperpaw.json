{
  "name": "OpenPaw / Temper Logs (ADR-0054)",
  "description": "Parses the JSON schema emitted by temper-observe::init_tracing and registers official facets for @tenant, @entity_type, @entity_id, @action_name, @trace_id, @span_id, @error.kind. Includes sensitive-data scanner rules to redact known secret shapes at ingest.",
  "is_enabled": true,
  "filter": {
    "query": "service:(temper OR openpaw)"
  },
  "processors": [
    {
      "type": "grok-parser",
      "name": "Ingest the JSON body as structured attributes",
      "is_enabled": true,
      "source": "message",
      "grok": {
        "support_rules": "",
        "match_rules": "json_body %{data::json}"
      }
    },
    {
      "type": "attribute-remapper",
      "name": "Remap service.name to standard service",
      "is_enabled": true,
      "sources": [
        "service"
      ],
      "source_type": "attribute",
      "target": "service",
      "target_type": "tag",
      "preserve_source": true,
      "override_on_conflict": true
    },
    {
      "type": "attribute-remapper",
      "name": "Remap trace_id / span_id to Datadog-standard keys",
      "is_enabled": true,
      "sources": [
        "trace_id"
      ],
      "source_type": "attribute",
      "target": "dd.trace_id",
      "target_type": "attribute",
      "preserve_source": false,
      "override_on_conflict": true
    },
    {
      "type": "attribute-remapper",
      "name": "Remap span_id",
      "is_enabled": true,
      "sources": [
        "span_id"
      ],
      "source_type": "attribute",
      "target": "dd.span_id",
      "target_type": "attribute",
      "preserve_source": false,
      "override_on_conflict": true
    },
    {
      "type": "attribute-remapper",
      "name": "Rename entity status to avoid collision with DD log status",
      "is_enabled": true,
      "sources": ["status"],
      "source_type": "attribute",
      "target": "entity_status",
      "target_type": "attribute",
      "preserve_source": false,
      "override_on_conflict": true
    },
    {
      "type": "status-remapper",
      "name": "Remap OTEL severity_text to DD log status",
      "is_enabled": true,
      "sources": ["otel.severity_text", "level"]
    },
    {
      "type": "date-remapper",
      "name": "Use message timestamp",
      "is_enabled": true,
      "sources": [
        "timestamp"
      ]
    },
    {
      "type": "message-remapper",
      "name": "Keep human-readable message",
      "is_enabled": true,
      "sources": [
        "message"
      ]
    }
  ]
}