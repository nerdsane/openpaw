<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="Paw.Vocab" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Term Name="AuthZ.CedarPolicy" Type="Edm.String" AppliesTo="EntityType Action Function"/>
      <Term Name="Agent.Hint" Type="Edm.String" AppliesTo="Action Function EntityType"/>
    </Schema>

    <Schema Namespace="DSF.Harness" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <EntityType Name="DsfWorkCycle">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>

        <!-- Link to parent Harness -->
        <Property Name="HarnessId" Type="Edm.String"/>

        <!-- Work cycle fields -->
        <Property Name="TaskSummary" Type="Edm.String"/>
        <Property Name="PlannerId" Type="Edm.String"/>
        <Property Name="PlanSummary" Type="Edm.String"/>
        <Property Name="TestSummary" Type="Edm.String"/>
        <Property Name="PrUrl" Type="Edm.String"/>
        <Property Name="ApproverId" Type="Edm.String"/>
        <Property Name="ErrorMessage" Type="Edm.String"/>
        <Property Name="SandboxUrl" Type="Edm.String"/>
        <Property Name="ReviewNotes" Type="Edm.String"/>

        <!-- Gate booleans -->
        <Property Name="HasPlan" Type="Edm.Boolean"/>
        <Property Name="MigrationsOk" Type="Edm.Boolean"/>
        <Property Name="TypecheckOk" Type="Edm.Boolean"/>
        <Property Name="UnitTestsOk" Type="Edm.Boolean"/>
        <Property Name="DstOk" Type="Edm.Boolean"/>
        <Property Name="PolicyGatesOk" Type="Edm.Boolean"/>
        <Property Name="E2eOk" Type="Edm.Boolean"/>
        <Property Name="TestsPassed" Type="Edm.Boolean"/>

        <Annotation Term="Paw.Vocab.AuthZ.CedarPolicy" String="policies/dsf_harness.cedar"/>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Work cycle for deep-sci-fi development governance. Linked to a parent Harness entity via HarnessId. Tracks plan, implementation, testing, and review for one change."/>
      </EntityType>

      <!-- Configure (sets harness link + task context) -->

      <Action Name="Configure" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <Parameter Name="harness_id" Type="Edm.String" Nullable="true"/>
        <Parameter Name="task_summary" Type="Edm.String" Nullable="true"/>
        <Parameter Name="planner_id" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <!-- Work cycle actions -->

      <Action Name="WritePlan" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <Parameter Name="plan_summary" Type="Edm.String" Nullable="false"/>
        <Parameter Name="planner_id" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="StartWork" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="UpdateSandbox" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <Parameter Name="sandbox_url" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <!-- Gate report actions (self-loops in InProgress) -->

      <Action Name="ReportMigrations" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="ReportTypecheck" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="ReportUnitTests" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="ReportDst" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="ReportPolicyGates" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="ReportE2e" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <!-- Testing and review actions -->

      <Action Name="BeginTesting" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="PassTests" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <Parameter Name="test_summary" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="Approve" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <Parameter Name="approver_id" Type="Edm.String" Nullable="true"/>
        <Parameter Name="pr_url" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="RequestChanges" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <Parameter Name="review_notes" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <Action Name="Fail" IsBound="true">
        <Parameter Name="bindingParameter" Type="DSF.Harness.DsfWorkCycle"/>
        <Parameter Name="error_message" Type="Edm.String" Nullable="true"/>
        <ReturnType Type="DSF.Harness.DsfWorkCycle"/>
      </Action>

      <EntityContainer Name="DSFHarnessService">
        <EntitySet Name="DsfWorkCycles" EntityType="DSF.Harness.DsfWorkCycle"/>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
