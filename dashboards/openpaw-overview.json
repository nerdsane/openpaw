{
  "title": "OpenPaw — Platform Overview",
  "description": "Single pane of glass for OpenPaw agent orchestration health.",
  "layout_type": "ordered",
  "widgets": [
    {
      "definition": {
        "title": "Platform Health",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "OTLP Spans Received",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.otlp.spans{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OTLP Traces Received",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.otlp.traces{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Trace Agent Sampler (Kept vs Seen)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.sampler.kept{*}.as_count()",
                  "display_type": "line"
                },
                {
                  "q": "sum:datadog.trace_agent.sampler.seen{*}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "APM Traces (service:openpaw)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Spans by Resource",
              "type": "toplist",
              "requests": [
                {
                  "q": "top(count:trace.custom{service:openpaw} by {resource_name}.as_count(), 10, 'sum', 'desc')",
                  "conditional_formats": [],
                  "style": {}
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Trace Flame Graph",
              "type": "trace_service",
              "service": "openpaw",
              "env": "",
              "span_name": "",
              "show_hits": true,
              "show_errors": true,
              "show_latency": true,
              "show_breakdown": true,
              "size_format": "large",
              "display_format": "three_column"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Runtime Metrics",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Active Entities",
              "type": "timeseries",
              "requests": [
                { "q": "avg:temper_active_entities{*}", "display_type": "line" }
              ]
            }
          },
          {
            "definition": {
              "title": "Active Actors",
              "type": "timeseries",
              "requests": [
                { "q": "avg:temper_active_actors{*}", "display_type": "line" }
              ]
            }
          },
          {
            "definition": {
              "title": "Process Memory (RSS)",
              "type": "timeseries",
              "requests": [
                { "q": "avg:process_resident_memory_bytes{*}", "display_type": "line" }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Invocations",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_wasm_invocations_total{*} by {trigger_action,success}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Invoke Duration (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_wasm_invocation_duration_ms{*} by {trigger_action}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "WASM Host HTTP Response Bytes",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_wasm_host_http_response_bytes{*} by {call_kind,status_code_class}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Executions",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_wasm_invocations_total{trigger_action:processtoolcalls,needs_wasi:true,success:true}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Active Invocations (max)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "max:temper_monty_repl_observed_active_invocations{*} by {max_concurrency}.rollup(max, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Wait (avg ms)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:temper_monty_repl_wait_duration_ms{*} by {max_concurrency}.rollup(avg, 60)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Monty REPL Acquisitions",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:temper_monty_repl_acquisitions_total{*} by {max_concurrency}.as_count().rollup(sum, 60)",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "tags": ["team:openpaw"]
}
