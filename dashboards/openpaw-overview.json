{
  "title": "OpenPaw — Platform Overview",
  "description": "Single pane of glass for OpenPaw agent orchestration health.",
  "layout_type": "ordered",
  "widgets": [
    {
      "definition": {
        "title": "Platform Health",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "OTLP Spans Received",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.otlp.spans{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "OTLP Traces Received",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.otlp.traces{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Trace Agent Sampler (Kept vs Seen)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:datadog.trace_agent.sampler.kept{*}.as_count()",
                  "display_type": "line"
                },
                {
                  "q": "sum:datadog.trace_agent.sampler.seen{*}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "APM Traces (service:openpaw)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Spans by Resource",
              "type": "toplist",
              "requests": [
                {
                  "q": "top(count:trace.custom{service:openpaw} by {resource_name}.as_count(), 10, 'sum', 'desc')",
                  "conditional_formats": [],
                  "style": {}
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Trace Flame Graph",
              "type": "trace_service",
              "service": "openpaw",
              "env": "",
              "span_name": "",
              "show_hits": true,
              "show_errors": true,
              "show_latency": true,
              "show_breakdown": true,
              "size_format": "large",
              "display_format": "three_column"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Runtime Metrics",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Active Entities",
              "type": "timeseries",
              "requests": [
                { "q": "avg:temper_active_entities{*}", "display_type": "line" }
              ]
            }
          },
          {
            "definition": {
              "title": "Active Actors",
              "type": "timeseries",
              "requests": [
                { "q": "avg:temper_active_actors{*}", "display_type": "line" }
              ]
            }
          },
          {
            "definition": {
              "title": "Process Memory (RSS)",
              "type": "timeseries",
              "requests": [
                { "q": "avg:process_resident_memory_bytes{*}", "display_type": "line" }
              ]
            }
          }
        ]
      }
    }
  ],
  "tags": ["team:openpaw"]
}
